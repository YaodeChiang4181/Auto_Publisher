generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Venue {
  id          String   @id @default(uuid())
  name        String
  geoLat      Float
  geoLng      Float
  geoRadius   Float    // in meters
  externalId   String?  @unique // 泛用型外部對接 ID (非必填)
  externalMeta Json?    // 泛用型外部對接擴充資料 (例如：儲存多個售票系統的 ID 映射)
  isActive     Boolean  @default(true)
  contactName  String?
  contactPhone String?
  status       String   @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events      Event[]
  adminUsers  AdminUser[]
  ads         Advertisement[]
}

model Event {
  id           String          @id @default(uuid())
  venueId      String
  name         String
  startTime    DateTime
  unlockTime   DateTime
  externalId   String?  @unique // 泛用型外部對接 ID (非必填)
  externalMeta Json?    // 泛用型外部對接擴充資料
  gmControlToken String? @unique // GM 控制台專屬 Token
  gmLineUserId   String?         // GM 的 LINE ID，用來接收預警
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  venue        Venue           @relation(fields: [venueId], references: [id])
  pushContents PushContent[]
  scanStats    EventScanStat?
  sessions     Session[]
  trendingCache TrendingResult[]
  actionLogs   ActionLog[]
  characters   EventCharacter[]
}

model PushContent {
  id           String   @id @default(uuid())
  eventId      String
  title        String
  contentUrl   String?
  merchLink    String?
  couponCode   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model EventScanStat {
  id             String   @id @default(uuid())
  eventId        String   @unique
  totalAttendance   Int?     // 現場總人數 (人工輸入)
  totalScans        Int      @default(0)
  verifiedScans     Int      @default(0)
  geoVerifiedScans  Int      @default(0)
  lastScannedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model ActionLog {
  id          String   @id @default(uuid())
  sessionId   String
  eventId     String
  actionType  String   // "CLICK_SOCIAL_SHARE" | "CLICK_AD"
  timestamp   DateTime @default(now())

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Session {
  id             String   @id @default(uuid())
  eventId        String
  browserToken   String   @unique // 去識別化的 browser cookie / PWA session ID
  verifiedAt     DateTime @default(now())
  isUnlocked     Boolean  @default(false)
  lineUserId     String?  // 儲存 LINE User ID
  
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actionLogs     ActionLog[]
}

model AdminUser {
  id             String   @id @default(uuid())
  username       String   @unique
  passwordHash   String
  name           String
  role               String   @default("VENUE_MANAGER") // "SUPER_ADMIN" 或 "VENUE_MANAGER"
  twoFactorSecret    String?
  isTwoFactorEnabled Boolean  @default(false)
  venueId            String?  // 如果是超級管理員可能為空
  savedLocations     Json?    // 常用座標記憶庫，儲存格式：[{ name: string, lat: number, lng: number }]
  createdAt          DateTime @default(now())
  updatedAt      DateTime @updatedAt

  venue          Venue?   @relation(fields: [venueId], references: [id])
}

model Advertisement {
  id          String   @id @default(uuid())
  title       String
  description String?
  imageUrl    String?
  linkUrl     String
  type        String   @default("CENTRAL") // "CENTRAL" or "VENUE"
  venueId     String?
  venue       Venue?   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  campaignId  String?
  campaign    AdCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clickCount  Int      @default(0)
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
}

model AdCampaign {
  id           String   @id @default(uuid())
  title        String
  sponsor      String
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean  @default(true)
  targetVenues String?  // JSON Array of Venue IDs, null = 全區聯播
  createdAt    DateTime @default(now())
  
  ads          Advertisement[]
}

model TrendingResult {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  platform    String   // "Dcard", "PTT", "IG", "Web"
  title       String
  snippet     String
  url         String
  imageUrl    String?
  createdAt   DateTime @default(now())
}

model EventCharacter {
  id             String   @id @default(uuid())
  eventId        String
  name           String   // 角色名稱
  bindingCode    String   // 綁定代碼 (商家自訂)
  textEnding     String?  // 專屬文字結局
  fileUrl        String?  // 商家上傳的檔案位址或內容
  boundLineId    String?  // 玩家綁定後的 LINE User ID

  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  @@unique([eventId, bindingCode])
}
